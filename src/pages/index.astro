---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="mx-auto flex min-h-screen max-w-3xl flex-col justify-center px-6 py-16">
		<p class="mb-4 text-sm tracking-widest text-neutral-400 uppercase">Portfolio</p>
		<h1 class="text-5xl font-semibold tracking-tight text-balance sm:text-6xl">
			Hi, I'm Amit.
		</h1>
		<p class="mt-6 max-w-xl text-lg text-neutral-300">
			Building things on the web. This site is a fresh Astro rebuild — content coming soon.
		</p>
	</main>
</Layout>
